CAPI=2:

name: dune-daq:daphne-fullstream:board-control:0.1.0
description: Board-control AXI-Lite registers for fan, bias, mux, LEDs, and channel enables
provider:
  name: local

filesets:
  rtl:
    files:
      - ../../ip_repo/daphne3_ip/rtl/daphne3_package.vhd
      - ../../ip_repo/daphne3_ip/rtl/config/fanmon.vhd
      - ../../ip_repo/daphne3_ip/rtl/config/stuff.vhd
    file_type: vhdlSource-2008
  tb:
    files:
      - ../../tests/logic/stuff_axi_smoke_tb.vhd
    file_type: vhdlSource-2008

targets:
  default: &default_target
    filesets:
      - rtl
  sim:
    <<: *default_target
    default_tool: ghdl
    filesets_append:
      - tb
    toplevel: stuff_axi_smoke_tb
    tools:
      ghdl:
        analyze_options:
          - --std=08
        run_options:
          - --assert-level=error
          - --stop-time=10us
