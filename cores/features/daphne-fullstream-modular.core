CAPI=2:

name: dune-daq:daphne-fullstream:daphne-fullstream-modular:0.1.0
description: Modular fullstream source manifest assembled from reusable boundary scaffolds
provider:
  name: local

filesets:
  rtl_boundaries:
    depend:
      - dune-daq:daphne-fullstream:control-plane:0.1.0
      - dune-daq:daphne-fullstream:analog-control:0.1.0
      - dune-daq:daphne-fullstream:timing-subsystem:0.1.0
      - dune-daq:daphne-fullstream:frontend-boundary:0.1.0
      - dune-daq:daphne-fullstream:stream-pipeline:0.1.0
      - dune-daq:daphne-fullstream:hermes-boundary:0.1.0
      - dune-daq:daphne-fullstream:spy-buffer-boundary:0.1.0

targets:
  default:
    filesets:
      - rtl_boundaries
